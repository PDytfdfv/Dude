:root {
  --bg: #17181d;
  --panel: #202128;
  --panel2: #292a33;
  --line: #383a46;
  --text: #f0f0f4;
  --muted: #a5a7b5;
  --accent: #a994ff;
  --danger: #ff7777;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 14px/1.4 Inter, ui-sans-serif, system-ui,
        -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
  height: 100vh;
  overflow: hidden;
}

button,
input {
  font: inherit;
}

button {
  border: 1px solid var(--line);
  background: #2a2b34;
  color: var(--text);
  border-radius: 8px;
  padding: 8px 11px;
  cursor: pointer;
}

button:hover {
  border-color: #77718e;
  background: #343541;
}

button.primary {
  background: var(--accent);
  color: #171323;
  border-color: transparent;
  font-weight: 700;
}


/* TOP BAR */

.topbar {
  height: 68px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18px;
  border-bottom: 1px solid var(--line);
  background: #1d1e24;
}

.brand {
  display: flex;
  gap: 10px;
  align-items: center;
}

.brand-mark {
  font-size: 27px;
  color: var(--accent);
}

.brand strong {
  display: block;
  font-size: 15px;
}

.brand small {
  display: block;
  color: var(--muted);
  font-size: 11px;
}

.file-actions {
  display: flex;
  gap: 8px;
}


/* MAIN LAYOUT */

.app {
  height: calc(100vh - 68px);
  display: grid;
  grid-template-columns: 78px minmax(300px, 1fr) 250px;
}


/* LEFT TOOLBAR */

.toolbar,
.right-panel {
  background: var(--panel);
  border-right: 1px solid var(--line);
  padding: 12px 10px;
  overflow: auto;
}

.right-panel {
  border-right: 0;
  border-left: 1px solid var(--line);
}

.section-label {
  font-size: 10px;
  letter-spacing: 1.5px;
  color: var(--muted);
  text-align: center;
  margin: 7px 0 12px;
}

.gap-top {
  margin-top: 25px;
}

.tool {
  width: 100%;
  height: 55px;
  margin-bottom: 6px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 2px;

  font-size: 20px;
  padding: 4px;
}

.tool span {
  font-size: 10px;
  color: var(--muted);
}

.tool.active {
  background: #39334f;
  border-color: var(--accent);
  color: var(--accent);
}


/* WORKSPACE */

.workspace {
  min-width: 0;
  display: flex;
  flex-direction: column;
}


/* OPTIONS */

.options {
  min-height: 54px;

  display: flex;
  align-items: center;

  gap: 15px;

  padding: 8px 14px;

  border-bottom: 1px solid var(--line);

  background: #202128;

  flex-wrap: wrap;
}

.options label {
  display: flex;
  align-items: center;
  gap: 7px;

  color: var(--muted);

  font-size: 12px;
}

.options input[type="color"] {
  width: 28px;
  height: 28px;

  border: 0;
  background: none;
  padding: 0;
}

.options input[type="range"] {
  width: 95px;
  accent-color: var(--accent);
}

output {
  font-variant-numeric: tabular-nums;
  color: var(--text);
  min-width: 42px;
}

.hint {
  margin-left: auto;
  color: #777987;
  font-size: 11px;
}


/* CANVAS */

.canvas-wrap {
  flex: 1;
  min-height: 0;

  overflow: auto;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 28px;

  background-color: #17181d;

  background-image:
    radial-gradient(
      #343540 1px,
      transparent 1px
    );

  background-size: 16px 16px;
}

.paper {
  position: relative;

  width: min(100%, 1200px);

  aspect-ratio: 3 / 2;

  background: white;

  box-shadow: 0 12px 45px #0007;

  flex-shrink: 0;

  overflow: hidden;
}

canvas {
  width: 100%;
  height: 100%;
  display: block;

  touch-action: none;
}

#vectorLayer {
  position: absolute;
  inset: 0;

  pointer-events: none;
}

#vectorLayer svg {
  width: 100%;
  height: 100%;

  display: block;

  overflow: visible;
}


/* FOOTER */

footer {
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 14px;

  border-top: 1px solid var(--line);

  color: var(--muted);

  font-size: 11px;
}


/* RIGHT PANEL */

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 5px 2px 12px;
}

.panel-head button {
  padding: 3px 9px;
  font-size: 18px;
}

.layers {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.layer-row {
  display: flex;
  align-items: center;
  gap: 7px;

  border: 1px solid var(--line);

  background: #292a32;

  border-radius: 8px;

  padding: 9px;

  cursor: pointer;
}

.layer-row.selected {
  border-color: var(--accent);
  background: #343047;
}

.layer-eye {
  border: 0;
  background: none;
  padding: 0 3px;
  color: var(--muted);
}

.layer-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;

  flex: 1;

  font-size: 12px;
}

.layer-kind {
  font-size: 9px;
  color: var(--muted);

  background: #3b3c47;

  padding: 3px 5px;

  border-radius: 4px;
}


/* PROPERTIES */

.properties-head {
  margin-top: 24px;

  border-top: 1px solid var(--line);

  padding-top: 18px;
}

.properties label {
  display: flex;
  flex-direction: column;

  gap: 7px;

  color: var(--muted);

  font-size: 11px;

  margin: 12px 0;
}

.properties input:not([type="range"]) {
  background: #17181d;

  border: 1px solid var(--line);

  border-radius: 6px;

  color: var(--text);

  padding: 8px;
}

.properties input[type="range"] {
  width: 100%;
  accent-color: var(--accent);
}

.button-row {
  display: flex;
  gap: 8px;
}

.button-row button {
  flex: 1;
}

.danger {
  color: var(--danger);
}


/* NOTE */

.note {
  margin-top: 22px;

  padding: 11px;

  background: #292a32;

  border: 1px solid var(--line);

  border-radius: 8px;

  color: var(--muted);

  font-size: 11px;
}

.note strong {
  color: var(--text);
}

.note p {
  margin-bottom: 0;
  line-height: 1.55;
}


/* MOBILE */

@media (max-width: 850px) {

  .app {
    grid-template-columns: 62px minmax(0, 1fr);
  }

  .right-panel {
    display: none;
  }

  .topbar {
    padding: 0 10px;
  }

  .file-actions {
    gap: 4px;
  }

  .file-actions button {
    padding: 7px;
    font-size: 11px;
  }

  .brand small {
    display: none;
  }

  .options {
    gap: 8px;
  }

  .hint {
    display: none;
  }

  .canvas-wrap {
    padding: 12px;
  }

}
